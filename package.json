{
  "name": "dsh-mimo-adapter",
  "version": "0.1.0",
  "description": "Xiaomi MiMo LLM adapter for DeepSeek Harness: reasoning-effort control plus audio and video input modalities",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/**/*.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test tests/mimo.test.mjs",
    "test:catalog": "node tests/catalog-wiring.mjs",
    "test:load": "node tests/load-check.mjs",
    "test:live": "node tests/live.mjs",
    "bootstrap": "node tests/bootstrap.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mimo",
    "xiaomi",
    "llm-adapter"
  ],
  "license": "MIT"
}
