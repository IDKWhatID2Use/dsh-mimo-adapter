# Harness packages are linked here by tests/bootstrap.mjs; a profile provides
# them at runtime, so nothing under node_modules is part of this package.
node_modules/

# Test scratch output.
tests/.e2e-requests.jsonl

# Editor and OS noise.
.DS_Store
Thumbs.db
*.log

# ---------------------------------------------------------------------------
# Secrets — this plugin needs a MiMo credential at runtime, but never ships
# one. Keep every plausible carrier out of the repository.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
secrets.json
credentials.json
.credentials
.credentials.*
*.pem
*.key
*.p12
*.pfx
!**/*.example

# Harness home artefacts (never part of the plugin).
sessions/
attachments/
reports/
*.sqlite
*.db
